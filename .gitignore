# ====================================================================
# Git Ignore Rules for AWS Usage & Report Analysis Platform
# ====================================================================

# Environment Variables & Secrets (CRITICAL: Never commit real secrets!)
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
!frontend/.env.development
!frontend/.env.production.example
*.pem
*.key
*.pfx

# Python artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js & Frontend dependencies/builds
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test Coverage & Cache
.coverage
htmlcov/
.pytest_cache/
.eslintcache
