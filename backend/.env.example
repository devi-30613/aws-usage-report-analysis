# ====================================================================
# AWS Usage & Report Analysis Platform - Backend Environment Configuration
# ====================================================================

# Application Mode: 'mock' (local CSV sample data) or 'aws' (Live S3 + Athena)
DATA_SOURCE=mock

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated). In production, set to your AWS Amplify URL:
# e.g., https://main.d123456789.amplifyapp.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Query Result Cache TTL (seconds)
CACHE_TTL_SECONDS=300

# AWS Region & Credentials
# (Note: In AWS App Runner, leave keys empty to use the IAM Instance Role!)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon S3 Data Storage Configuration
S3_BUCKET_NAME=
S3_PREFIX=raw-usage-data/
S3_REPORT_PREFIX=generated-reports/

# Amazon Athena Configuration
ATHENA_DATABASE=aws_usage_db
ATHENA_TABLE=aws_usage_reports
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-athena-query-results-bucket/athena-results/
